# Reverse proxy: automatic HTTPS (Let's Encrypt), HTTP/3, compression, body size limit.
# Set DOMAIN in the environment (e.g. quantumpass.example.com).
{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 1MB
	}

	reverse_proxy app:8000 {
		# Stream assistant replies (server-sent events) immediately instead of buffering.
		flush_interval -1
		header_up X-Forwarded-For {remote_host}
	}

	# The app sets its own security headers; hide server fingerprints.
	header -Server

	log {
		output stdout
		format json
	}
}
