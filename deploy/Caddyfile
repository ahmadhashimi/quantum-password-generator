# Only Caddy is internet-facing. API paths go straight to FastAPI, so generated secrets never pass through the
# Next.js server; everything else is the website.
{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 1MB
	}

	@api path /api/v2/* /quantum-* /.well-known/quantumpass-keys.json
	handle @api {
		reverse_proxy api:8000 {
			flush_interval -1 # stream assistant replies (SSE) without buffering
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	header {
		-Server
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	}

	# JSON access log; Caddy redacts Authorization and Cookie headers by default.
	log {
		output stdout
		format json
	}
}
