# Copy to deploy/.env (chmod 600). Never commit the real file.
DOMAIN=quantumpass.example.com
# URL-safe characters only (it is embedded in the database URL).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Clerk (https://dashboard.clerk.com): the publishable key is public; the secret key is not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Quantum entropy
ANU_API_KEY=
IBM_MODE=hardware
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
IBM_MAX_JOBS_PER_DAY=2

# Assistant (Sonnet 5.5 by default). Leave empty to disable.
ANTHROPIC_API_KEY=
ASSISTANT_DAILY_BUDGET_USD=10
ASSISTANT_MONTHLY_BUDGET_USD=150

# Signing keys: generated on first start into the api_data volume. To use keys from a secret store instead:
# SIGNING_KEYS={"ed25519": "...", "ml-dsa-65": "..."}
# After a rotation, list the old public keys here (python -m scripts.keys rotate prints this value):
# RETIRED_SIGNING_KEYS=[]
