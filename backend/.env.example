# Copy to backend/.env and fill in. Never commit the real file.
# Local development only — the default is production. docker-compose always forces production settings.
ENVIRONMENT=development
ALLOWED_HOSTS=["localhost","127.0.0.1"]
ALLOWED_ORIGINS=["http://localhost:3000"]
# Production (docker-compose sets these): ALLOWED_HOSTS=["yourdomain.com","api"], ALLOWED_ORIGINS=["https://yourdomain.com"]
# Logs: JSON lines outside development; set LOG_FORMAT=text|json and LOG_LEVEL=DEBUG|INFO|WARNING to override
LOG_FORMAT=text

# --- Quantum entropy -------------------------------------------------------
# ANU Quantum Numbers API key (https://quantumnumbers.anu.edu.au)
ANU_API_KEY=
# IBM Quantum: "simulator" to test the pipeline locally (no QPU time, NOT quantum), "hardware" for real QPUs
IBM_MODE=simulator
# IBM Cloud API key + Open Plan instance CRN (us-east) from https://quantum.cloud.ibm.com
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
IBM_MAX_JOBS_PER_DAY=2
POOL_PATH=./entropy_pool.bin

# --- AI assistant ----------------------------------------------------------
# Never paste this key into a chat. Model defaults to Sonnet 5.5 (ASSISTANT_MODEL=claude-sonnet-5-5).
ANTHROPIC_API_KEY=

# --- Clerk (login + user tracking) ----------------------------------------
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# The website's CSP (incl. the Clerk Frontend API host) is built by web/proxy.ts from NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY.

# SQLite for local dev; PostgreSQL in production (migrated with Alembic at startup):
# DATABASE_URL=postgresql+psycopg://qpg:<password>@localhost:5432/qpg
DATABASE_URL=sqlite:///./qpg.db
# Signing keys (0600 file, created on first start). Back up with: python -m scripts.keys backup ...
SIGNING_KEY_PATH=./signing_keys.json

# --- Cost guardrails -------------------------------------------------------
ASSISTANT_DAILY_MESSAGES_PER_USER=50
ASSISTANT_DAILY_BUDGET_USD=10
ASSISTANT_USER_DAILY_BUDGET_USD=1.00
ASSISTANT_MONTHLY_BUDGET_USD=150
ASSISTANT_MAX_TOKENS=1500
ASSISTANT_MAX_TOOL_ITERATIONS=3
