# Copy to backend/.env and fill in. Never commit the real file.
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000"]
# Production: ALLOWED_HOSTS=["yourdomain.com"]

# --- Quantum entropy -------------------------------------------------------
# ANU Quantum Numbers API key (https://quantumnumbers.anu.edu.au)
ANU_API_KEY=
# IBM Quantum: "simulator" to test the pipeline locally (no QPU time, NOT quantum), "hardware" for real QPUs
IBM_MODE=simulator
# IBM Cloud API key + Open Plan instance CRN (us-east) from https://quantum.cloud.ibm.com
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
IBM_MAX_JOBS_PER_DAY=2
POOL_PATH=./entropy_pool.bin

# --- AI assistant ----------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Clerk (login + user tracking) ----------------------------------------
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Add your production Clerk Frontend API host for the CSP, e.g. ["https://clerk.yourdomain.com"]
CLERK_HOSTS=["https://*.clerk.accounts.dev"]

DATABASE_URL=sqlite:///./qpg.db

# --- Cost guardrails -------------------------------------------------------
ASSISTANT_DAILY_MESSAGES_PER_USER=50
ASSISTANT_DAILY_BUDGET_USD=10
ASSISTANT_MAX_TOKENS=4000
ASSISTANT_MAX_TOOL_ITERATIONS=6
