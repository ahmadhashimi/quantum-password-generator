{
 "components": {
  "schemas": {
   "ChatRequest": {
    "properties": {
     "conversation_id": {
      "anyOf": [
       {
        "maxLength": 64,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Conversation Id"
     },
     "message": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "title": "ChatRequest",
    "type": "object"
   },
   "DrawCommit": {
    "properties": {
     "entries": {
      "items": {
       "maxLength": 400,
       "type": "string"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Entries",
      "type": "array"
     },
     "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
     },
     "winners": {
      "default": 1,
      "maximum": 100.0,
      "minimum": 1.0,
      "title": "Winners",
      "type": "integer"
     }
    },
    "required": [
     "title",
     "entries"
    ],
    "title": "DrawCommit",
    "type": "object"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "title": "Detail",
      "type": "array"
     }
    },
    "title": "HTTPValidationError",
    "type": "object"
   },
   "ReceiptIn": {
    "properties": {
     "algorithms": {
      "anyOf": [
       {
        "items": {
         "maxLength": 16,
         "type": "string"
        },
        "maxItems": 4,
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Algorithms"
     },
     "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
     },
     "signatures": {
      "additionalProperties": {
       "maxLength": 8192,
       "type": "string"
      },
      "maxProperties": 4,
      "propertyNames": {
       "maxLength": 16
      },
      "title": "Signatures",
      "type": "object"
     }
    },
    "required": [
     "payload",
     "signatures"
    ],
    "title": "ReceiptIn",
    "type": "object"
   },
   "ValidationError": {
    "properties": {
     "ctx": {
      "title": "Context",
      "type": "object"
     },
     "input": {
      "title": "Input"
     },
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "title": "Location",
      "type": "array"
     },
     "msg": {
      "title": "Message",
      "type": "string"
     },
     "type": {
      "title": "Error Type",
      "type": "string"
     }
    },
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError",
    "type": "object"
   },
   "VerifyRequest": {
    "properties": {
     "entries": {
      "anyOf": [
       {
        "items": {
         "maxLength": 400,
         "type": "string"
        },
        "maxItems": 10000,
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Entries"
     },
     "receipt": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/ReceiptIn"
       },
       {
        "type": "null"
       }
      ]
     },
     "receipt_id": {
      "anyOf": [
       {
        "maxLength": 64,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Receipt Id"
     },
     "salt": {
      "anyOf": [
       {
        "maxLength": 128,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Salt"
     },
     "value": {
      "anyOf": [
       {
        "maxLength": 4096,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Value"
     }
    },
    "title": "VerifyRequest",
    "type": "object"
   }
  }
 },
