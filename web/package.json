{
  "name": "quantumpass-web",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ./lib/api/openapi.json -o ./lib/api/schema.d.ts",
    "check:api": "openapi-typescript ./lib/api/openapi.json -o ./lib/api/schema.check.d.ts && node -e \"const f=require('fs');if(f.readFileSync('lib/api/schema.d.ts','utf8')!==f.readFileSync('lib/api/schema.check.d.ts','utf8')){console.error('lib/api/schema.d.ts is stale: run npm run gen:api');process.exit(1)}\" && rm lib/api/schema.check.d.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.17",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "lucide-react": "1.59.0",
    "motion": "14.3.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
