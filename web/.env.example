# Copy to .env.local for `npm run dev`. Without Clerk keys the app runs in local mode against a backend
# with ENVIRONMENT=development (auto signed-in local admin).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Server-side calls from Next to FastAPI (dashboards). In Docker: http://api:8000
API_INTERNAL_URL=http://localhost:8000
# Dev/e2e only: proxy /api/v2/* to FastAPI from `next dev` / `next start`. Never set in production images;
# there Caddy routes /api/v2/* straight to the API, so secrets never pass through the Next.js server.
API_REWRITE_ORIGIN=http://localhost:8000
